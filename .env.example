# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Home layout
VERTICAL_HOME="false"

# Contact form
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Consensus Salutis <contacto@example.com>"
CONTACT_TO_EMAIL="adrian@binpar.com"

# Evaluador de idoneidad (AWS Marketplace)
# Obligatorios: el build falla si faltan. Mínimo 32 caracteres cada uno.
# Genera MARKETPLACE_TOKEN_PEPPER con: openssl rand -base64 48
#
# MARKETPLACE_SESSION_SECRET NO se genera aquí: tiene que ser EXACTAMENTE el
# mismo valor que en el deployment de Convex. Es el secreto simétrico con el que
# Convex firma la sesión de la entrevista y con el que esta landing la verifica;
# si los dos lados no coinciden, la Etapa 0 crea la evaluación y la Etapa 1
# devuelve 401 en la primera llamada.
#   npx convex env get MARKETPLACE_SESSION_SECRET   (en el monorepo)
MARKETPLACE_SESSION_SECRET=""
MARKETPLACE_TOKEN_PEPPER=""

# Deployment de Convex que sirve la entrevista (#5). OJO: `.convex.site`, que es
# donde viven las `httpAction`, y no `.convex.cloud`.
#
# El origen de esta landing tiene que estar en `MARKETPLACE_ALLOWED_ORIGIN` del
# deployment, o el navegador no podrá abrir el stream:
#   npx convex env set MARKETPLACE_ALLOWED_ORIGIN "http://localhost:3000,https://consensussalutis.com"
NEXT_PUBLIC_CONVEX_SITE_URL="https://hidden-impala-19.convex.site"

# Registro de AWS Marketplace (/aws/registration, issue #3).
#
# NO rompen el build si faltan: la landing entera —home, blog, evaluador
# público— se despliega sin listing. Lo que sí falla, y en seco, es la ruta de
# registro: sin AWS_MP_PRODUCT_CODE devuelve 503 en vez de dar por bueno
# cualquier producto, que sería el fallo que no puede pasar delante del revisor.
#
# Los tres primeros ya están puestos en Vercel (production y preview) por
# BinPar/consensus-salutis#91, junto con el rol y el proveedor OIDC. Aquí solo
# hacen falta para trabajar en local contra el simulador.
#
# El código del producto aparece en su página de resumen en AWS.
AWS_MP_PRODUCT_CODE=""
# Rol de la cuenta que registró el producto, asumido por federación OIDC desde
# Vercel. AWS exige que ResolveCustomer se llame DESDE esa cuenta: desde otra la
# llamada funciona igual y aun así no cuenta para la revisión.
AWS_ROLE_ARN=""
# us-east-1 con independencia de dónde se despliegue: el servicio de Metering
# del Marketplace vive ahí.
AWS_REGION="us-east-1"
# Solo desarrollo: el resolve-stub del simulador del monorepo, que habla el
# protocolo real de ResolveCustomer sin credenciales de AWS.
#   ./apps/editor/node_modules/.bin/tsx scripts/marketplace-sim.mts resolve-stub
# Con esta variable puesta no se asume ningún rol. Déjala vacía en Vercel.
AWS_MP_RESOLVE_ENDPOINT=""

# /sign-in de apps/chat, para el enlace de "ya tengo cuenta" que exige AWS.
# Todo vive en consensussalutis.com sin subdominios, así que por defecto es una
# ruta del mismo origen. Solo hay que ponerlo si la plataforma se sirve aparte.
NEXT_PUBLIC_PLATFORM_SIGN_IN_URL="/sign-in"
